# Modèle de configuration. Copier ce fichier en ".env" puis remplacer les valeurs.
# Le vrai fichier .env ne doit JAMAIS être commité (il est dans .gitignore).

# Clés d'accès à SeaweedFS (API S3) : choisir deux valeurs de son choix.
S3_ACCESS_KEY=change-me-access-key
S3_SECRET_KEY=change-me-secret-key-12345

# Compte de connexion à NiFi (mot de passe d'au moins 12 caractères).
NIFI_USER=admin
NIFI_PASSWORD=change-me-12-caracteres-min

# Dossier de ton PC qui contient les données du projet (avec des /, même sous Windows).
# Il doit contenir un sous-dossier "Hospitalisation".
DATA_DIR=C:/Users/votre-nom/Downloads/DATA 2024

#Sftp server 
SFTP_USER=chu_ftp
SFTP_PASSWORD=change-me-sftp

# Base de soins (source 1)
PG_SUPER_PASSWORD=change-me-super
PG_SOURCE_READER_PASSWORD=change-me-reader
