# Copier en .env (non versionné) et changer les mots de passe.

POSTGRES_USER=chu
POSTGRES_PASSWORD=chu_dev_password
POSTGRES_DB=chu_dw
PG_PORT=5432
ICEBERG_CATALOG_DB=iceberg_catalog

# Compte de Spark (staging + catalogue Iceberg) et compte de Superset (lecture seule sur gold)
ETL_USER=etl
ETL_PASSWORD=etl_dev_password
BI_USER=bi
BI_PASSWORD=bi_dev_password

# pgAdmin (http://localhost:5050) : l'e-mail doit avoir un domaine valide
PGADMIN_EMAIL=admin@chu.fr
PGADMIN_PASSWORD=admin_dev_password

# Clé de pseudonymisation : graine du coffre OpenBao (rangée au démarrage par openbao-init, puis lue par Silver
# directement dans le coffre : le conteneur spark ne la reçoit plus). La changer change TOUS les pseudonymes.
SILVER_HMAC_KEY=changer_moi

# OpenBao (http://localhost:8200, mode développement) : jeton racine, utilisé uniquement par openbao-init
# et pour consulter le coffre à la main. Choisir une valeur longue et aléatoire.
OPENBAO_ROOT_TOKEN=changer_moi_jeton_openbao

# Facultatif : accès SFTP à ranger aussi dans le coffre (mêmes valeurs que bronze/.env)
# SFTP_USER=chu_ftp
# SFTP_PASSWORD=...

# Airflow (http://localhost:8080) : compte de l'interface, mot de passe de sa base, clés (valeurs longues et aléatoires)
# fernet : python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin_dev_password
AIRFLOW_DB_PASSWORD=airflow_dev_password
AIRFLOW_SECRET_KEY=changer_moi_cle_airflow_longue_et_aleatoire
AIRFLOW_FERNET_KEY=changer_moi_cle_fernet_base64_32_octets=
# Facultatif : URL de webhook (Teams, Slack...) appelée à l'échec définitif d'une tâche
# ALERT_WEBHOOK_URL=

SPARK_DRIVER_MEMORY=4g
# Cœurs de Spark en local (local[*] = tous : trop gourmand en mémoire sur le job deces)
SPARK_MASTER=local[4]

# Superset (http://localhost:8088) : clé secrète longue et aléatoire
SUPERSET_SECRET_KEY=changer_moi_cle_superset_longue_et_aleatoire
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin_dev_password
SUPERSET_ADMIN_EMAIL=admin@chu.fr

# Clés S3 de SeaweedFS (Spark). Lancé depuis la racine, ces valeurs priment sur celles
# de bronze/.env : garder les mêmes dans les deux fichiers.
S3_ACCESS_KEY=change-me-access-key
S3_SECRET_KEY=change-me-secret-key-12345
